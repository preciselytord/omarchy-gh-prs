#!/bin/bash
# gh-prs — your open GitHub pull requests and their checks, as JSON.
#
#   list [query]                    every open PR the search finds, by repository
#   detail <owner/repo> <n>         one PR in full: checks by name, reviewers,
#                                   mergeability and the merge method to use
#   merge <owner/repo> <n> <method> <sha>
#                                   merge it, only if its head is still <sha>
#   close <owner/repo> <n> [delete-branch]
#                                   close it, and delete its branch if asked
#   copy <url>                      put a PR's URL on the clipboard
#   sort [status|date]              print, or save, the panel's sort order
#   automerge arm <owner/repo> <n> <method> <sha>
#                                   merge it once its checks pass, rebasing it
#                                   when it falls behind; pinned to <sha>
#   automerge disarm <owner/repo> <n>
#   automerge tick                  move every armed PR one step on
#   demo on|off                     invented PRs instead of yours, for screenshots
#
# The list is one GraphQL search, paged, per refresh. Check states come from
# each PR's head commit status rollup as counts per state, so a PR with eighty
# checks costs no more than one with two. The search is `is:pr is:open
# author:@me archived:false` unless the panel passes its own.
#
# What the list leaves out is what makes a search slow: check names, reviewers
# and mergeability. With those in it, even 25-PR pages run into GitHub's
# ten-second limit and come back 502 or 504 a fair share of the time, so they
# are fetched by `detail`, for one PR, when its detail view is opened. That is
# also when they matter, and they are fresh then, which is what a Merge button
# should be looking at.
#
# Pages are 50 PRs, not GraphQL's maximum of 100, for the same reason, and a
# gateway error is retried once before it is reported.
#
# Merging never passes --admin, and always passes --match-head-commit with the
# SHA the panel showed, so a commit pushed after the detail view was loaded is
# never merged unseen: GitHub refuses the merge instead.
#
# Every failure is still a JSON object with `ok: false` and a one-line
# `error`, so the panel can keep showing what it had and say why.
#
# Titles, repository and owner names come from GitHub and are printed as JSON
# strings, drawn as plain text, and never handed to a shell. Arguments coming
# back from the panel are checked for shape before they reach a command line.

set -euo pipefail
umask 077

readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-gh-prs"
readonly DEMO_FILE="$CACHE_DIR/demo"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-gh-prs"
readonly SORT_FILE="$STATE_DIR/sort"
readonly AM_LIVE_FILE="$STATE_DIR/automerge.json"
readonly AM_DEMO_FILE="$CACHE_DIR/automerge-demo.json"
readonly AM_LOCK="$STATE_DIR/automerge.lock"
readonly AM_TICK_LOCK="$STATE_DIR/automerge-tick.lock"
readonly DEFAULT_QUERY="is:pr is:open author:@me archived:false"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly DEMO_DATA="$SCRIPT_DIR/../assets/demo.json"
readonly SELF="$SCRIPT_DIR/gh-prs"

json_string() {
  printf '%s' "${1-}" | jq -Rs .
}

die() {
  printf '{"ok":false,"error":%s,"groups":[]}\n' "$(json_string "$1")"
  exit 0
}

ok() {
  printf '{"ok":true,"message":%s}\n' "$(json_string "$1")"
  exit 0
}

valid_repo() { [[ "${1-}" =~ ^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$ ]]; }
valid_number() { [[ "${1-}" =~ ^[0-9]{1,9}$ ]]; }
valid_sha() { [[ "${1-}" =~ ^[0-9a-f]{40}$ ]]; }
valid_method() { [[ "${1-}" =~ ^(merge|squash|rebase)$ ]]; }
valid_url() { [[ "${1-}" =~ ^https://[A-Za-z0-9.-]+/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+$ ]]; }

read -r -d '' LIST_QUERY <<'GRAPHQL' || true
query($q: String!, $endCursor: String) {
  search(query: $q, type: ISSUE, first: 50, after: $endCursor) {
    pageInfo { hasNextPage endCursor }
    nodes {
      ... on PullRequest {
        number title url isDraft reviewDecision createdAt updatedAt
        headRefName baseRefName
        author { login }
        repository { name nameWithOwner owner { login } }
        commits(last: 1) {
          nodes {
            commit {
              statusCheckRollup {
                contexts(first: 0) {
                  checkRunCountsByState { state count }
                  statusContextCountsByState { state count }
                }
              }
            }
          }
        }
      }
    }
  }
}
GRAPHQL

read -r -d '' DETAIL_QUERY <<'GRAPHQL' || true
query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    squashMergeAllowed mergeCommitAllowed rebaseMergeAllowed
    pullRequest(number: $number) {
      id number title url state isDraft reviewDecision createdAt updatedAt
      headRefName baseRefName headRefOid mergeable mergeStateStatus
      author { login }
      repository { name nameWithOwner owner { login } }
      latestOpinionatedReviews(first: 20) { nodes { state author { login } } }
      reviewRequests(first: 20) {
        nodes { requestedReviewer { ... on User { login } ... on Team { name } } }
      }
      commits(last: 1) {
        nodes {
          commit {
            statusCheckRollup {
              contexts(first: 100) {
                checkRunCountsByState { state count }
                statusContextCountsByState { state count }
                nodes {
                  __typename
                  ... on CheckRun { name status conclusion }
                  ... on StatusContext { context state }
                }
              }
            }
          }
        }
      }
    }
  }
}
GRAPHQL

# Shared by the list and the detail view, so the dot in a row and the
# breakdown behind it can never disagree.
#
# A check counts against a PR when it ended badly: failed, cancelled, timed
# out, waiting on someone to approve the run, never started, or left stale by
# GitHub. It is still running while it is queued, pending, waiting or in
# progress. Success, neutral and skipped are all fine, and so is a bare
# `completed`, which is a run that finished without a conclusion.
#
# Failing outranks running: one red check already decides the PR, however many
# are still going.
# shellcheck disable=SC2016 # jq, not shell, expands these
readonly CHECKS='
  def failing: ["FAILURE","CANCELLED","TIMED_OUT","ACTION_REQUIRED","STARTUP_FAILURE","STALE","ERROR"];
  def pending: ["PENDING","QUEUED","IN_PROGRESS","WAITING","EXPECTED","REQUESTED"];
  def isin($list): . as $s | $list | index($s) != null;

  def review:
    if . == "APPROVED" then "approved"
    elif . == "CHANGES_REQUESTED" then "changes requested"
    elif . == "REVIEW_REQUIRED" then "review required"
    else "" end;

  def checks:
    (.commits.nodes[0].commit.statusCheckRollup.contexts // {}) as $c
    | (($c.checkRunCountsByState // []) + ($c.statusContextCountsByState // [])) as $counts
    | def n(f): [$counts[] | select(.state | f) | .count] | add // 0;
      {
        total: n(true),
        failing: n(isin(failing)),
        running: n(isin(pending)),
        passed: n(. == "SUCCESS" or . == "COMPLETED"),
        skipped: n(. == "SKIPPED"),
        neutral: n(. == "NEUTRAL")
      }
    | .done = .total - .running
    | .state = (if .total == 0 then "none"
                elif .failing > 0 then "failing"
                elif .running > 0 then "running"
                else "passing" end)
    | .label = (if .state == "failing" then "failing \(.failing)"
                elif .state == "running" then "running \(.done)/\(.total)"
                elif .state == "passing" then "passing"
                else "no checks" end);

  def summary:
    checks as $k
    | {
        number, title, url, createdAt,
        updatedAt: (.updatedAt // .createdAt),
        draft: .isDraft,
        author: (.author.login // "ghost"),
        owner: .repository.owner.login,
        repo: .repository.name,
        repoFull: .repository.nameWithOwner,
        head: .headRefName,
        base: .baseRefName,
        state: $k.state,
        label: $k.label,
        checks: $k,
        review: (.reviewDecision | review)
      };
'

# shellcheck disable=SC2016
readonly LIST_TRANSFORM="$CHECKS"'
  [.[].data.search.nodes[] | select(.number != null) | summary
   | . + {autoMerge: ($am[.repoFull + "#" + (.number | tostring)] // null
                      | if . == null then null else {status: (.status // "armed")} end)}] as $prs
  | def count(f): [$prs[] | select(f)] | length;
  {
    ok: true,
    error: "",
    fetchedAt: now | floor,
    total: ($prs | length),
    failing: count(.state == "failing"),
    running: count(.state == "running"),
    passing: count(.state == "passing"),
    none: count(.state == "none"),
    drafts: count(.draft),
    badge: {
      failing: count(.state == "failing" and (.draft | not)),
      running: count(.state == "running" and (.draft | not)),
      failingDrafts: count(.state == "failing" and .draft),
      runningDrafts: count(.state == "running" and .draft)
    },
    groups: ($prs
      | group_by(.repoFull | ascii_downcase)
      | map({
          repo: .[0].repoFull,
          failing: ([.[] | select(.state == "failing")] | length),
          prs: (sort_by(.updatedAt) | reverse)
        })
      | sort_by(.prs[0].updatedAt) | reverse)
  }
'

# The merge button is only live when GitHub would take the merge without an
# admin override and the panel has nothing it would want to warn about first.
# The first reason that applies is the one shown on the button.
#
# The method is squash when the repository allows it, then a merge commit,
# then rebase: whatever the repository allows, in that order.
# shellcheck disable=SC2016
readonly DETAIL_TRANSFORM="$CHECKS"'
  .data.repository as $r
  | $r.pullRequest as $p
  | ($p | summary) as $s
  | ($p.commits.nodes[0].commit.statusCheckRollup.contexts.nodes // []) as $nodes
  | [$nodes[]
     | if .__typename == "CheckRun"
       then {name, state: (if .status == "COMPLETED" then (.conclusion // "COMPLETED") else .status end)}
       else {name: .context, state} end] as $runs
  | ([$p.latestOpinionatedReviews.nodes[]? | select(.state == "APPROVED") | .author.login]) as $approved
  | ([$p.latestOpinionatedReviews.nodes[]? | select(.state == "CHANGES_REQUESTED") | .author.login]) as $changes
  | ([$p.reviewRequests.nodes[]?.requestedReviewer | .login // .name | select(. != null)]) as $requested
  | (if $r.squashMergeAllowed then "squash"
     elif $r.mergeCommitAllowed then "merge"
     elif $r.rebaseMergeAllowed then "rebase"
     else "" end) as $method
  | ($p.mergeStateStatus // "UNKNOWN") as $ms
  | (if $p.state == "MERGED" then "already merged"
     elif $p.state == "CLOSED" then "closed"
     elif $p.isDraft then "draft"
     elif $p.mergeable == "CONFLICTING" or $ms == "DIRTY" then "conflicts with \($p.baseRefName)"
     elif $s.checks.failing > 0 then "checks failing"
     elif $s.checks.running > 0 then "checks running"
     elif $p.reviewDecision == "CHANGES_REQUESTED" then "changes requested"
     elif $p.reviewDecision == "REVIEW_REQUIRED" then "review required"
     elif $ms == "BLOCKED" then "blocked by branch rules"
     elif $ms == "BEHIND" then "behind \($p.baseRefName)"
     elif $ms == "UNKNOWN" or $p.mergeable == "UNKNOWN" then "GitHub is still checking; refresh"
     elif $method == "" then "no merge method allowed"
     else "" end) as $block
  | {
      ok: true,
      error: "",
      fetchedAt: now | floor,
      pr: ($s + {
        open: ($p.state == "OPEN"),
        prState: $p.state,
        nodeId: $p.id,
        headSha: $p.headRefOid,
        mergeable: ($p.mergeable // "UNKNOWN"),
        mergeState: $ms,
        mergeMethod: $method,
        mergeBlock: $block,
        approvedBy: $approved,
        changesBy: $changes,
        requested: $requested,
        failingNames: [$runs[] | select(.state | isin(failing)) | .name],
        runningNames: [$runs[] | select(.state | isin(pending)) | .name],
        listedChecks: ($runs | length)
      })
    }
'

# gh says what went wrong in its own words on stderr. Most of that is useful
# and too long for one line of a panel, so the common cases get a short name.
explain() {
  local err="$1"
  case "$err" in
    *"auth login"*|*"HTTP 401"*|*"Bad credentials"*)
      echo "gh is not signed in: run gh auth login" ;;
    *"dial tcp"*|*"no such host"*|*"could not resolve"*|*"connection refused"*|*"network is unreachable"*|*"i/o timeout"*|*"TLS handshake"*)
      echo "GitHub is unreachable (offline?)" ;;
    *"HTTP 502"*|*"HTTP 503"*|*"HTTP 504"*)
      echo "GitHub timed out; will retry" ;;
    *"rate limit"*)
      echo "GitHub rate limit hit; will retry" ;;
    *)
      printf '%s' "$err" | tr '\n' ' ' | sed 's/^gh: //; s/[[:space:]]*$//' | cut -c1-160 ;;
  esac
}

# Runs gh with stderr captured, retrying once on a gateway error. Prints
# stdout on success. On failure it prints the error object and returns 1, so
# a caller capturing its output can pass the object on: a die here would only
# leave the subshell.
gh_run() {
  local out errfile rc attempt
  errfile="$(mktemp)"
  for attempt in 1 2; do
    rc=0
    out="$(gh "$@" 2>"$errfile")" || rc=$?
    (( rc == 0 )) && break
    grep -qE 'HTTP 50[234]' "$errfile" || break
    (( attempt == 1 )) && sleep 2
  done
  local err
  err="$(cat "$errfile")"
  rm -f "$errfile"
  if (( rc != 0 )); then
    printf '{"ok":false,"error":%s,"groups":[]}\n' "$(json_string "$(explain "$err")")"
    return 1
  fi
  printf '%s' "$out"
}

graphql_error() {
  jq -r '[(if type == "array" then .[] else . end) | .errors[]?.message] | first // empty' 2>/dev/null || true
}

demo_on() { [[ -f "$DEMO_FILE" ]]; }

# Demo PRs carry ages rather than dates, so a screenshot taken next year still
# says "updated 2h".
demo_data() {
  jq 'map(.data.search.nodes |= map(
        .createdAt = (now - .createdAgo | floor | todate)
        | .updatedAt = (now - .updatedAgo | floor | todate)))' "$DEMO_DATA"
}

list() {
  local query="${1:-$DEFAULT_QUERY}"
  [[ -n "${query// }" ]] || query="$DEFAULT_QUERY"

  if demo_on; then
    demo_data | jq --argjson am "$(am_state)" "$LIST_TRANSFORM"
    return
  fi

  command -v gh >/dev/null || die "gh is not installed"
  local out gql_error
  out="$(gh_run api graphql --paginate --slurp -f query="$LIST_QUERY" -f q="$query")" \
    || { printf '%s\n' "$out"; exit 0; }
  gql_error="$(graphql_error <<<"$out")"
  [[ -z "$gql_error" ]] || die "GitHub: $gql_error"
  jq --argjson am "$(am_state)" "$LIST_TRANSFORM" <<<"$out" 2>/dev/null || die "unexpected response from GitHub"
}

detail() {
  local repo="${1-}" number="${2-}"
  valid_repo "$repo" || die "not a repository: $repo"
  valid_number "$number" || die "not a PR number: $number"

  if demo_on; then
    jq --arg repo "$repo" --argjson n "$number" '
      [.[].data.search.nodes[] | select(.repository.nameWithOwner == $repo and .number == $n)][0] as $p
      | if $p == null then {ok: false, error: "no such demo PR"}
        else {data: {repository: ($p.repository + {pullRequest: $p})}} end' <(demo_data) \
      | jq "if .ok == false then . else ($DETAIL_TRANSFORM) end"
    return
  fi

  command -v gh >/dev/null || die "gh is not installed"
  # GitHub works out mergeability lazily: the first request for a PR nobody
  # has looked at lately says UNKNOWN and starts the computation, and asking
  # again a moment later usually has the answer.
  local out gql_error attempt
  for attempt in 1 2; do
    out="$(gh_run api graphql -f query="$DETAIL_QUERY" \
      -f owner="${repo%%/*}" -f name="${repo#*/}" -F number="$number")" \
      || { printf '%s\n' "$out"; exit 0; }
    jq -e '.data.repository.pullRequest.mergeable == "UNKNOWN"' <<<"$out" >/dev/null 2>&1 || break
    (( attempt == 1 )) && sleep 1.5
  done
  gql_error="$(graphql_error <<<"$out")"
  [[ -z "$gql_error" ]] || die "GitHub: $gql_error"
  jq "$DETAIL_TRANSFORM" <<<"$out" 2>/dev/null || die "unexpected response from GitHub"
}

# Run from / so a branch deletion can only ever be the remote one: gh deletes
# the local branch too when it is run inside a checkout of the repository.
merge() {
  local repo="${1-}" number="${2-}" method="${3-}" sha="${4-}"
  valid_repo "$repo" || die "not a repository: $repo"
  valid_number "$number" || die "not a PR number: $number"
  valid_method "$method" || die "not a merge method: $method"
  valid_sha "$sha" || die "not a commit SHA: $sha"
  demo_on && ok "demo mode: nothing merged"

  cd /
  local out
  out="$(gh_run pr merge "$number" -R "$repo" "--$method" --match-head-commit "$sha")" \
    || { printf '%s\n' "$out"; exit 0; }
  ok "merged $repo#$number ($method)"
}

close_pr() {
  local repo="${1-}" number="${2-}" delete="${3-}"
  valid_repo "$repo" || die "not a repository: $repo"
  valid_number "$number" || die "not a PR number: $number"
  [[ -z "$delete" || "$delete" == "delete-branch" ]] || die "unexpected argument: $delete"
  demo_on && ok "demo mode: nothing closed"

  cd /
  local args=(pr close "$number" -R "$repo")
  [[ -n "$delete" ]] && args+=(--delete-branch)
  local out
  out="$(gh_run "${args[@]}")" || { printf '%s\n' "$out"; exit 0; }
  if [[ -n "$delete" ]]; then ok "closed $repo#$number and deleted its branch"; fi
  ok "closed $repo#$number"
}

copy() {
  local url="${1-}"
  valid_url "$url" || die "not a PR URL"
  command -v wl-copy >/dev/null || die "wl-copy is not installed"
  printf '%s' "$url" | wl-copy 2>/dev/null || die "could not reach the clipboard"
  ok "copied"
}

# The panel's sort order, kept here rather than in shell.json (see Panel.qml).
# Anything but the two known values reads as the default.
sort_order() {
  case "${1-}" in
    "")
      local mode=""
      [[ -f "$SORT_FILE" ]] && mode="$(head -c 16 "$SORT_FILE")"
      [[ "$mode" == "date" ]] && echo date || echo status ;;
    status|date)
      mkdir -p "$STATE_DIR"
      printf '%s\n' "$1" >"$SORT_FILE.tmp" && mv "$SORT_FILE.tmp" "$SORT_FILE" ;;
    *) echo "usage: gh-prs sort [status|date]" >&2; exit 2 ;;
  esac
}

# ------------------------------------------------------------- auto-merge
#
# GitHub's own auto-merge is off in many organisations, and it never rebases.
# This is the same idea run from here: an armed PR is merged once its checks
# pass, and when the base moves on and the repository requires branches to be
# up to date, it is rebased (by GitHub, updatePullRequestBranch with REBASE)
# and waited on again, as many times as that takes.
#
# It moves only when `tick` runs, which the panel does on every refresh, so
# nothing happens while the shell is down or the machine asleep.
#
# Only the oldest armed PR in each repository is worked on. Merging one puts
# every other PR in a strict repository behind, so rebasing them all at once
# would only run their checks for nothing.
#
# Arming pins the PR to the head commit the detail view showed, and every
# rebase done here moves the pin to the commit it produced. A head that is
# anything else means someone pushed, and auto-merge stops rather than merge
# commits nobody looked at. So does anything a wait would not fix: failing
# checks, conflicts, requested changes, a draft. Each stop, and each merge,
# is a desktop notification.

am_file() { if demo_on; then echo "$AM_DEMO_FILE"; else echo "$AM_LIVE_FILE"; fi; }

am_state() {
  local f
  f="$(am_file)"
  if [[ -s "$f" ]] && jq -e 'type == "object"' "$f" >/dev/null 2>&1; then cat "$f"; else echo '{}'; fi
}

# Applies a jq program to the state, under a short lock so a tick and a click
# in the panel never write over each other.
am_update() {
  local program="$1"; shift
  local f
  f="$(am_file)"
  mkdir -p "$STATE_DIR" "$(dirname "$f")"
  (
    flock -w 10 9 || exit 1
    am_state | jq "$@" "$program" >"$f.tmp" && mv "$f.tmp" "$f"
  ) 9>"$AM_LOCK"
}

am_has() {
  am_state | jq -e --arg k "$1" 'has($k)' >/dev/null
}

am_set() {
  local key="$1" patch="$2"
  am_update 'if has($k) then .[$k] += $p else . end' --arg k "$key" --argjson p "$patch"
}

am_remove() {
  am_update 'del(.[$k])' --arg k "$1"
}

# Names and titles come from GitHub, and some notification daemons read the
# body as markup, so it goes out as plain text.
notify() {
  command -v notify-send >/dev/null || return 0
  local body
  body="$(printf '%s' "${2-}" | tr -d '<>&')"
  notify-send -a "GitHub PRs" -i github "$1" "$body" 2>/dev/null || true
}

automerge_arm() {
  local repo="${1-}" number="${2-}" method="${3-}" sha="${4-}"
  valid_repo "$repo" || die "not a repository: $repo"
  valid_number "$number" || die "not a PR number: $number"
  valid_method "$method" || die "not a merge method: $method"
  valid_sha "$sha" || die "not a commit SHA: $sha"
  local now
  now="$(date +%s)"
  am_update '.[$k] = {repo: $repo, number: ($n | tonumber), method: $method, sha: $sha,
                     armedAt: $now, changedAt: $now, status: "armed"}' \
    --arg k "$repo#$number" --arg repo "$repo" --arg n "$number" --arg method "$method" \
    --arg sha "$sha" --argjson now "$now" || die "could not save the auto-merge state"
  ok "auto-merge on for $repo#$number"
}

automerge_disarm() {
  local repo="${1-}" number="${2-}"
  valid_repo "$repo" || die "not a repository: $repo"
  valid_number "$number" || die "not a PR number: $number"
  am_remove "$repo#$number" || die "could not save the auto-merge state"
  ok "auto-merge off for $repo#$number"
}

# What to do with one armed PR, from its detail record: done, disarm, rebase,
# merge or wait, and why. Rebasing comes before waiting on checks: checks on a
# branch that is behind are checks that will have to run again anyway.
# A review that was not required before a rebase done here, and is after it,
# is a branch rule treating the rebased commits as new changes, which no
# amount of waiting fixes.
# A PR blocked with nothing failing is given fifteen minutes after its head
# last changed, which is how long required checks may take to show up at all.
# shellcheck disable=SC2016
readonly AM_DECIDE='
  .pr as $p
  | if ($p.open | not) then ["done", (if $p.prState == "MERGED" then "merged" else "closed" end)]
    elif $p.headSha != $sha then ["disarm", "new commits since auto-merge was turned on"]
    elif $p.draft then ["disarm", "it is a draft"]
    elif $p.mergeable == "CONFLICTING" or $p.mergeState == "DIRTY" then ["disarm", "conflicts with \($p.base)"]
    elif $p.checks.failing > 0 then ["disarm", "checks failing"]
    elif $p.review == "changes requested" then ["disarm", "changes requested"]
    elif $p.mergeState == "BEHIND" then ["rebase", "behind \($p.base)"]
    elif $p.checks.running > 0 then ["wait", "waiting for checks (\($p.checks.label))"]
    elif $p.mergeBlock == "" then ["merge", ""]
    elif $p.review == "review required" and $reviewAtRebase != null and $reviewAtRebase != "review required"
      then ["disarm", "a review is required again since the rebase (a branch rule counts the rebase as a new change)"]
    elif $p.review == "review required" then ["wait", "waiting for review"]
    elif $p.mergeState == "UNKNOWN" or $p.mergeable == "UNKNOWN" then ["wait", "GitHub is still checking"]
    elif $p.mergeState == "BLOCKED" and ($now - $changed) < 900 then ["wait", "waiting for required checks"]
    else ["disarm", $p.mergeBlock]
    end
  | @tsv
'

read -r -d '' REBASE_MUTATION <<'GRAPHQL' || true
mutation($id: ID!, $sha: GitObjectID!) {
  updatePullRequestBranch(input: {pullRequestId: $id, expectedHeadOid: $sha, updateMethod: REBASE}) {
    pullRequest { headRefOid }
  }
}
GRAPHQL

# Rebases the PR onto its base and prints the new head. GitHub refuses if the
# head is no longer <sha>. The new head is usually in the reply; when it is
# not yet, it is read back for a few seconds.
am_rebase() {
  local repo="$1" number="$2" node="$3" sha="$4" out new attempt
  out="$(gh_run api graphql -f query="$REBASE_MUTATION" -f id="$node" -f sha="$sha")" \
    || { jq -r .error <<<"$out"; return 1; }
  local gql_error
  gql_error="$(graphql_error <<<"$out")"
  [[ -z "$gql_error" ]] || { echo "GitHub: $gql_error"; return 1; }
  new="$(jq -r '.data.updatePullRequestBranch.pullRequest.headRefOid // empty' <<<"$out")"
  for attempt in 1 2 3 4 5; do
    [[ -n "$new" && "$new" != "$sha" ]] && break
    sleep 2
    new="$(gh api "repos/$repo/pulls/$number" --jq .head.sha 2>/dev/null || true)"
  done
  valid_sha "$new" || { echo "could not read the head after rebasing"; return 1; }
  printf '%s\n' "$new"
}

# A rebase or merge that fails is tried again on the next tick: on a strict
# repository the base can move between looking and merging, and GitHub can
# still say BEHIND for a moment after a rebase. Three in a row, and it stops.
am_failed() {
  local key="$1" entry="$2" what="$3" why="$4" n
  n=$(( $(jq -r '.failures // 0' <<<"$entry") + 1 ))
  if (( n >= 3 )); then
    am_remove "$key"
    notify "Auto-merge off for $key: $what" "$why"
  else
    am_set "$key" "$(jq -nc --argjson n "$n" --arg s "$what ($n/3), will retry: $why" '{failures: $n, status: $s}')"
  fi
}

am_step() {
  local key="$1" entry repo number method sha changed pending d now
  entry="$(am_state | jq -c --arg k "$key" '.[$k] // empty')"
  [[ -n "$entry" ]] || return 0
  repo="$(jq -r .repo <<<"$entry")"
  number="$(jq -r .number <<<"$entry")"
  method="$(jq -r .method <<<"$entry")"
  sha="$(jq -r .sha <<<"$entry")"
  changed="$(jq -r '.changedAt // 0' <<<"$entry")"
  pending="$(jq -r '.rebasePending // false' <<<"$entry")"
  valid_repo "$repo" && valid_number "$number" && valid_method "$method" && valid_sha "$sha" \
    || { am_remove "$key"; return 0; }

  d="$("$SELF" detail "$repo" "$number")"
  if ! jq -e '.ok == true' <<<"$d" >/dev/null 2>&1; then
    am_set "$key" "$(jq -nc --arg e "$(jq -r '.error // "no reply"' <<<"$d" 2>/dev/null)" '{status: ("could not check: " + $e)}')"
    return 0
  fi
  now="$(date +%s)"

  # A rebase this script asked for whose new head it never got to read.
  local head
  head="$(jq -r '.pr.headSha // empty' <<<"$d")"
  if [[ "$pending" == "true" && "$head" != "$sha" ]] && valid_sha "$head"; then
    sha="$head"
    changed="$now"
    am_set "$key" "$(jq -nc --arg s "$sha" --argjson t "$now" '{sha: $s, changedAt: $t, rebasePending: false}')"
  fi

  local decision action reason
  decision="$(jq -r --arg sha "$sha" --argjson changed "$changed" --argjson now "$now" \
    --argjson reviewAtRebase "$(jq -c '.reviewAtRebase // null' <<<"$entry")" "$AM_DECIDE" <<<"$d")"
  action="${decision%%$'\t'*}"
  reason="${decision#*$'\t'}"
  local title
  title="$(jq -r '.pr.title // ""' <<<"$d")"

  # The user may have turned it off while this tick was looking.
  if [[ "$action" == "merge" || "$action" == "rebase" ]] && ! am_has "$key"; then return 0; fi

  case "$action" in
    done)
      am_remove "$key"
      [[ "$reason" == "merged" ]] && notify "Merged $key" "$title"
      [[ "$reason" == "closed" ]] && notify "Auto-merge off: $key was closed" "$title"
      ;;
    disarm)
      am_remove "$key"
      notify "Auto-merge off for $key: $reason" "$title"
      ;;
    wait)
      am_set "$key" "$(jq -nc --arg s "$reason" '{status: $s}')"
      ;;
    rebase)
      if demo_on; then am_set "$key" '{"status":"demo: would rebase"}'; return 0; fi
      local node new
      node="$(jq -r '.pr.nodeId // empty' <<<"$d")"
      am_set "$key" "$(jq -nc --arg s "rebasing onto $(jq -r .pr.base <<<"$d")" \
        --arg r "$(jq -r '.pr.review' <<<"$d")" '{status: $s, rebasePending: true, reviewAtRebase: $r}')"
      if new="$(am_rebase "$repo" "$number" "$node" "$sha")"; then
        am_set "$key" "$(jq -nc --arg s "$new" --argjson t "$now" \
          '{sha: $s, changedAt: $t, rebasePending: false, failures: 0, status: "rebased; waiting for checks"}')"
      else
        am_set "$key" '{"rebasePending": false}'
        am_failed "$key" "$entry" "rebase failed" "$new"
      fi
      ;;
    merge)
      if demo_on; then am_set "$key" '{"status":"demo: would merge"}'; return 0; fi
      am_set "$key" '{"status":"merging"}'
      local res
      res="$("$SELF" merge "$repo" "$number" "$method" "$sha")"
      if jq -e '.ok == true' <<<"$res" >/dev/null 2>&1; then
        am_remove "$key"
        notify "Merged $key" "$title"
      else
        am_failed "$key" "$entry" "merge failed" "$(jq -r '.error // ""' <<<"$res" 2>/dev/null)"
      fi
      ;;
    *)
      am_set "$key" '{"status":"unexpected decision"}'
      ;;
  esac
}

# One tick at a time: a refresh that comes round while the last tick is still
# rebasing skips its turn.
automerge_tick() {
  mkdir -p "$STATE_DIR"
  exec 8>"$AM_TICK_LOCK"
  flock -n 8 || ok "a tick is already running"
  [[ "$(am_state)" != "{}" ]] || ok "nothing armed"
  command -v gh >/dev/null || die "gh is not installed"

  local active key
  mapfile -t active < <(am_state | jq -r '
    to_entries | group_by(.value.repo | ascii_downcase)
    | map(min_by(.value.armedAt)) | .[].key')
  for key in "${active[@]}"; do
    am_step "$key"
  done
  am_update '
    (to_entries | group_by(.value.repo | ascii_downcase)
     | map(min_by(.value.armedAt) | {key: (.value.repo | ascii_downcase), value: .value.number})
     | from_entries) as $first
    | with_entries(
        ($first[.value.repo | ascii_downcase]) as $n
        | if $n != null and $n != .value.number
          then .value.status = "queued behind #\($n)" else . end)' || true
  ok "ticked"
}

automerge() {
  local sub="${1-}"
  shift || true
  case "$sub" in
    arm) automerge_arm "$@" ;;
    disarm) automerge_disarm "$@" ;;
    tick) automerge_tick ;;
    *) echo "usage: gh-prs automerge arm <owner/repo> <n> <method> <sha> | disarm <owner/repo> <n> | tick" >&2; exit 2 ;;
  esac
}

demo() {
  mkdir -p "$CACHE_DIR"
  case "${1-}" in
    on) : >"$DEMO_FILE" ;;
    off) rm -f "$DEMO_FILE" ;;
    *) echo "usage: gh-prs demo on|off" >&2; exit 2 ;;
  esac
}

usage() {
  echo "usage: gh-prs list [query] | detail <owner/repo> <n> | merge <owner/repo> <n> <method> <sha>" >&2
  echo "       gh-prs close <owner/repo> <n> [delete-branch] | copy <url> | sort [status|date] | demo on|off" >&2
  echo "       gh-prs automerge arm <owner/repo> <n> <method> <sha> | automerge disarm <owner/repo> <n> | automerge tick" >&2
  exit 2
}

cmd="${1-list}"
shift || true
case "$cmd" in
  list) list "${1-}" ;;
  detail) detail "$@" ;;
  merge) merge "$@" ;;
  close) close_pr "$@" ;;
  copy) copy "$@" ;;
  sort) sort_order "$@" ;;
  automerge) automerge "$@" ;;
  demo) demo "$@" ;;
  *) usage ;;
esac
